# Apex Lane — Stripe test-mode placeholders
# Copy to .env.local and fill with Stripe Dashboard → Developers values.

# Server
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...   # $12/mo recurring price id
STRIPE_PRICE_YEARLY=price_...    # $99/yr recurring price id
STRIPE_WEBHOOK_SECRET=whsec_...  # from Stripe CLI or Dashboard webhook

# Optional: existing test customer for /api/portal demo
# STRIPE_CUSTOMER_ID=cus_...

# Client / public
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_BASE_URL=http://localhost:3000
